{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://edutrack-ey49.onrender.com/api/:path*"
    },
    {
      "source": "/neon-db/:path*",
      "destination": "https://edutrack-ey49.onrender.com/neon-db/:path*"
    },
    {
      "source": "/((?!assets/|uploads/|manifest.json).*)",
      "destination": "/index.html"
    }
  ]
}